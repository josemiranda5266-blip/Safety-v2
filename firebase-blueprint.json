{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with Freemium credit information",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["professional", "admin"] },
        "plan": { "type": "string", "enum": ["free", "pro", "pro_plus"] },
        "monthlyCredits": { "type": "number" },
        "creditsUsed": { "type": "number" },
        "billingPeriodStart": { "type": "string" },
        "billingPeriodEnd": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "role", "plan", "monthlyCredits", "creditsUsed", "billingPeriodStart", "billingPeriodEnd"]
    },
    "DocumentItem": {
      "title": "DocumentItem",
      "description": "Uploaded safety document or law",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "author": { "type": "string" },
        "uploadDate": { "type": "string" },
        "documentDate": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "pageCount": { "type": "number" },
        "fileType": { "type": "string" },
        "fileSize": { "type": "number" },
        "chunksCount": { "type": "number" },
        "summary": { "type": "string" },
        "content": { "type": "string" }
      },
      "required": ["userId", "title", "category"]
    },
    "DocChunk": {
      "title": "DocChunk",
      "description": "Document text chunk for RAG search",
      "properties": {
        "userId": { "type": "string" },
        "docId": { "type": "string" },
        "docTitle": { "type": "string" },
        "category": { "type": "string" },
        "pageNumber": { "type": "number" },
        "text": { "type": "string" }
      },
      "required": ["userId", "docId", "text"]
    },
    "FavoriteItem": {
      "title": "FavoriteItem",
      "description": "User saved favorite query or document snippet",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "sourceDoc": { "type": "string" },
        "sourcePage": { "type": "number" },
        "savedAt": { "type": "string" }
      },
      "required": ["userId", "title", "content"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "AI Chat thread with message history",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "messages": { "type": "array" }
      },
      "required": ["userId", "title"]
    },
    "SummaryResult": {
      "title": "SummaryResult",
      "description": "Technical summary generated by IA",
      "properties": {
        "userId": { "type": "string" },
        "docTitle": { "type": "string" },
        "category": { "type": "string" },
        "summary": { "type": "string" },
        "keyPoints": { "type": "array" },
        "legalRequirements": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "docTitle"]
    },
    "ChecklistInspection": {
      "title": "ChecklistInspection",
      "description": "Safety inspection checklist",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "area": { "type": "string" },
        "inspector": { "type": "string" },
        "date": { "type": "string" },
        "score": { "type": "number" },
        "items": { "type": "array" },
        "notes": { "type": "string" }
      },
      "required": ["userId", "title"]
    },
    "HazardAnalysisResult": {
      "title": "HazardAnalysisResult",
      "description": "Photo hazard inspection result",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "imageUrl": { "type": "string" },
        "riskLevel": { "type": "string" },
        "findings": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title"]
    },
    "CreditTransaction": {
      "title": "CreditTransaction",
      "description": "Log of AI credit deduction",
      "properties": {
        "userId": { "type": "string" },
        "operationType": { "type": "string" },
        "creditsDeducted": { "type": "number" },
        "timestamp": { "type": "string" },
        "success": { "type": "boolean" }
      },
      "required": ["userId", "operationType", "creditsDeducted", "timestamp"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Multi-tenant organization account",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "legalName": { "type": "string" },
        "taxId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "pro", "pro_plus", "enterprise"] },
        "planStatus": { "type": "string", "enum": ["active", "trial", "past_due", "cancelled"] },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "ownerUid", "plan", "planStatus", "contactEmail"]
    },
    "Membership": {
      "title": "Membership",
      "description": "User membership within an organization tenant",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "admin", "member", "auditor"] },
        "assignedCompanyIds": { "type": "array", "items": { "type": "string" } },
        "active": { "type": "boolean" },
        "invitedAt": { "type": "string" },
        "joinedAt": { "type": "string" }
      },
      "required": ["id", "orgId", "userId", "userEmail", "role", "active"]
    }
  }
}
